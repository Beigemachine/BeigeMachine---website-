* {
  box-sizing: border-box;
}

html, body {
  margin: 0;
  min-height: 100%;
}

body {
  min-height: 100vh;
  background: #11100e;
  color: #eee7d5;
  font-family: "Courier New", monospace;
  display: flex;
  align-items: center;
  justify-content: center;
  text-align: center;
  padding: 30px;
}

h1 {
  margin: 0 0 14px;
  font-size: clamp(38px, 9vw, 78px);
  letter-spacing: 4px;
  line-height: 1;
}

p {
  margin: 8px 0;
  font-size: clamp(15px, 4vw, 20px);
  line-height: 1.6;
}

.tagline {
  color: #4f9cff;
}

.construction {
  margin-top: 28px;
  padding: 12px 18px;
  border: 2px dashed #eee7d5;
  display: inline-block;
  text-transform: uppercase;
  letter-spacing: 2px;
}
