* {
  box-sizing: border-box;
}

body {
  margin: 0;
  background: #e9e4d8;
  color: #202020;
  font-family: "Courier New", Courier, monospace;
}

.container {
  max-width: 900px;
  margin: 0 auto;
  padding: 60px 30px;
}

h1 {
  font-size: 48px;
  margin-bottom: 10px;
}

.tagline {
  color: #245cff;
  font-weight: bold;
}

nav {
  margin: 30px 0;
}

nav a {
  color: #202020;
  text-decoration: none;
  margin-right: 24px;
  font-weight: bold;
}

nav a:hover {
  color: #245cff;
}

.hero {
  padding: 70px 0;
  border-top: 2px solid #202020;
  border-bottom: 2px solid #202020;
}

button,
.button {
  display: inline-block;
  margin-top: 20px;
  padding: 12px 20px;
  background: #245cff;
  color: white;
  border: 2px solid #202020;
  font-family: inherit;
  font-weight: bold;
  text-decoration: none;
  box-shadow: 4px 4px 0 #202020;
}

footer {
  margin-top: 60px;
  font-size: 14px;
}
